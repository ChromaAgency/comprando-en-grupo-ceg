<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="magento_profit_and_loss" model="account.report">
        <field name="name">Magento Profit and Loss</field>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_year</field>
        <field name="column_ids">
            <record id="magento_profit_and_loss_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="magento_account_financial_report_net_profit" model="account.report.line">
                <field name="name">Net Profit</field>
                <field name="code">MNEP</field>
                <field name="expression_ids">
                    <record id="magento_account_financial_report_net_profit0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">MOPINC.balance + MOIN.balance - MCOS.balance - MEXP.balance - MDEP.balance</field>
                        <field name="date_scope">normal</field>
                    </record>
                </field>
            </record>
            <record id="magento_account_financial_report_totalincome0" model="account.report.line">
                <field name="name">Income</field>
                <field name="code">MINC</field>
                <field name="expression_ids">
                    <record id="magento_account_financial_report_totalincome0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">MOPINC.balance + MOIN.balance</field>
                        <field name="date_scope">normal</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="magento_account_financial_report_gross_profit0" model="account.report.line">
                        <field name="name">Gross Profit</field>
                        <field name="code">MGRP</field>
                        <field name="expression_ids">
                            <record id="magento_account_financial_report_gross_profit0_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">MOPINC.balance - MCOS.balance</field>
                                <field name="date_scope">normal</field>
                            </record>
                        </field>
                        <field name="children_ids">
                            <record id="magento_account_financial_report_income0" model="account.report.line">
                                <field name="name">Operating Income</field>
                                <field name="code">MOPINC</field>
                                <field name="groupby">account_id</field>
                                <field name="foldable" eval="True"/>
                                <field name="expression_ids">
                                    <record id="magento_account_financial_report_income0_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'income')]"/>
                                        <field name="date_scope">normal</field>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                            <record id="magento_account_financial_report_cost_sales0" model="account.report.line">
                                <field name="name">Cost of Revenue</field>
                                <field name="code">MCOS</field>
                                <field name="groupby">account_id</field>
                                <field name="foldable" eval="True"/>
                                <field name="expression_ids">
                                    <record id="magento_account_financial_report_cost_sales0_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost')]"/>
                                        <field name="date_scope">normal</field>
                                        <field name="subformula">sum</field>
                                        <field name="green_on_positive" eval="False"/>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="magento_account_financial_report_other_income0" model="account.report.line">
                        <field name="name">Other Income</field>
                        <field name="code">MOIN</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="account_financial_report_other_income0_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'income_other')]"/>
                                <field name="date_scope">normal</field>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="magento_account_financial_report_less_expenses0" model="account.report.line">
                <field name="name">Expenses</field>
                <field name="code">MLEX</field>
                <field name="expression_ids">
                    <record id="magento_account_financial_report_less_expenses0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">MEXP.balance + MDEP.balance</field>
                        <field name="date_scope">normal</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="magento_account_financial_report_expense0" model="account.report.line">
                        <field name="name">Expenses</field>
                        <field name="code">MEXP</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="magento_account_financial_report_expense0_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense')]"/>
                                <field name="date_scope">normal</field>
                                <field name="subformula">sum</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                    <record id="magento_account_financial_report_depreciation0" model="account.report.line">
                        <field name="name">Depreciation</field>
                        <field name="code">MDEP</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                            <record id="magento_account_financial_report_depreciation0_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense_depreciation')]"/>
                                <field name="date_scope">normal</field>
                                <field name="subformula">sum</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
