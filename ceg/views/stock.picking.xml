<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_trade_unity" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <header>
                <button string="Picking List" name="action_get_picking_list" type="object" class="oe_stat_button" icon="fa-list"/>
            </header>
           
        </field>
    </record>
    <record id="vpicktree_inherit_trade_unity" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
             <header>
                <button string="Picking List" name="action_get_picking_list" type="object" class="oe_stat_button" icon="fa-list"/>
            </header>
            <list>
                <field name="exported_to_picking_list"/>
            </list>
        </field>
    </record>
</odoo>
