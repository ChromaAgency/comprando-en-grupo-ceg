<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job para limpiar tokens expirados -->
        <record id="ir_cron_cleanup_mexican_document_tokens" model="ir.cron">
            <field name="name">Cleanup Expired Mexican Document Tokens</field>
            <field name="model_id" ref="model_mexican_document_token"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_expired_tokens()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
